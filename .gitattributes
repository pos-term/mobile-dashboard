# Normalize line endings in the repository
* text=auto

# Shell scripts must keep LF, otherwise ./gradlew fails with "bad interpreter" on Linux/macOS
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files must keep CRLF
*.bat text eol=crlf

# Binary files
*.jar binary
*.webp binary
*.png binary
*.jpg binary
*.keystore binary
*.jks binary
